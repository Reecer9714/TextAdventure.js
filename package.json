{
  "name": "text-adventure",
  "version": "2.0.0",
  "type": "module",
  "packageManager": "pnpm@9.0.0",
  "description": "Run your own Text Adventure server",
  "keywords": [
    "text-adventure",
    "interactive-fiction",
    "game-engine",
    "cli",
    "web-server"
  ],
  "author": "Brooks Child <thebroox@gmail.com>",
  "license": "MIT",
  "main": "dist/web/server.js",
  "types": "dist/web/server.d.ts",
  "scripts": {
    "clean": "rm -rf dist",
    "build": "npm run build:server && vite build && npm run copy:cartridges",
    "build:server": "esbuild src/web/server.ts src/cli/server.ts --outdir=dist --format=esm --platform=node --bundle --external:express --external:chalk --external:console-read-write --external:open --external:@xterm/xterm --external:@xterm/addon-fit --external:@xterm/addon-web-links --external:body-parser --external:cors --external:helmet --external:express-rate-limit --external:path --external:fs --external:util --external:http --external:url --external:net --external:buffer --external:async_hooks --external:crypto --external:zlib --external:string_decoder --external:events --external:querystring --external:stream --external:assert --external:node:buffer --external:node:crypto --external:node:net",
    "build:web": "vite build",
    "copy:cartridges": "cp -r src/cartridges/** dist/cartridges",
    "dev": "vite dev --host",
    "dev:cli": "tsx src/cli/server.ts",
    "dev:web": "tsx watch src/web/server.ts",
    "dev:all": "concurrently \"npm run dev\" \"npm run dev:web\"",
    "start": "node dist/web/server.js",
    "start:web": "node dist/web/server.js",
    "start:cli": "node dist/cli/server.js",
    "lint": "oxlint src",
    "lint:fix": "oxlint src --fix",
    "format": "prettier --write src",
    "format:check": "prettier --check src",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "test:watch": "vitest watch",
    "test:coverage": "vitest run --coverage",
    "preview": "vite preview",
    "typecheck:watch": "tsc --noEmit --watch",
    "prepare": "husky"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/TheBroox/TextAdventure.js"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "@types/body-parser": "^1.19.6",
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.5",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^6.0.0",
    "body-parser": "^1.20.3",
    "chalk": "^5.3.0",
    "console-read-write": "^0.1.1",
    "cors": "^2.8.5",
    "dotenv": "^17.4.2",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "open": "^10.1.0"
  },
  "devDependencies": {
    "@types/jquery": "^4.0.0",
    "@types/node": "^22.10.5",
    "@types/supertest": "^7.0.0",
    "@typescript-eslint/eslint-plugin": "^8.19.1",
    "@typescript-eslint/parser": "^8.19.1",
    "@vitejs/plugin-basic-ssl": "^2.3.0",
    "concurrently": "^9.1.0",
    "esbuild": "^0.28.0",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^10.0.1",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "oxlint": "^1.60.0",
    "oxlint-tsgolint": "^0.21.0",
    "prettier": "^3.4.2",
    "supertest": "^7.0.0",
    "terser": "^5.46.1",
    "tsx": "^4.19.2",
    "typescript": "^5.4.2",
    "vite": "^6.0.0",
    "vitest": "^2.1.4"
  }
}