{
  "name": "text-adventure",
  "version": "2.0.0",
  "type": "module",
  "description": "Run your own Text Adventure server",
  "keywords": [
    "text-adventure",
    "interactive-fiction",
    "game-engine",
    "cli",
    "web-server"
  ],
  "author": "Brooks Child <thebroox@gmail.com>",
  "license": "MIT",
  "main": "dist/web/server.js",
  "types": "dist/web/server.d.ts",
  "scripts": {
    "clean": "shx rm -rf dist",
    "build": "npm run clean && tsc && npm run copy",
    "copy": "npm run copy:web && npm run copy:cartridges",
    "copy:cartridges": "shx cp -r src/cartridges/** dist/cartridges",
    "copy:web": "shx cp -r src/web/static/** dist/web/static",
    "dev": "tsc --watch",
    "start": "node dist/web/server.js",
    "start:web": "node dist/web/server.js",
    "start:cli": "node dist/cli/server.js",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix",
    "format": "prettier --write src",
    "format:check": "prettier --check src",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "test:watch": "vitest watch",
    "test:coverage": "vitest run --coverage"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/TheBroox/TextAdventure.js"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "@types/body-parser": "^1.19.6",
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.5",
    "body-parser": "^1.20.3",
    "chalk": "^5.3.0",
    "console-read-write": "^0.1.1",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "open": "^10.1.0"
  },
  "devDependencies": {
    "@types/jquery": "^4.0.0",
    "@types/node": "^22.10.5",
    "@types/supertest": "^6.0.2",
    "@typescript-eslint/eslint-plugin": "^8.19.1",
    "eslint-config-prettier": "^10.0.1",
    "@typescript-eslint/parser": "^8.19.1",
    "eslint": "^9.17.0",
    "prettier": "^3.4.2",
    "shx": "^0.3.4",
    "supertest": "^7.0.0",
    "typescript": "^5.4.2",
    "vitest": "^4.1.4"
  }
}
